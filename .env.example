# Anthropic API key (https://console.anthropic.com) - used server-side only
ANTHROPIC_API_KEY=

# Mapbox public token (https://account.mapbox.com) - map + place verification
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional: planning depth for each day. low (default, ~1 min per trip) | medium | high  (higher = more careful but slower)
WANDER_EFFORT=low

# Optional: affiliate IDs, added to booking links once you're approved
NEXT_PUBLIC_GYG_PARTNER_ID=
NEXT_PUBLIC_BOOKING_AID=

# Protection for public deployments (leave the code empty locally to skip it)
# Visitors must enter this code (or open /?invite=CODE) before planning.
WANDER_INVITE_CODE=
# Per-visitor daily limits (approximate on Vercel; see src/lib/guard.ts)
WANDER_DAILY_PLANS=5
WANDER_DAILY_REPLANS=20
WANDER_DAILY_TIKTOK=40
WANDER_DAILY_SHARES=50

# Upstash Redis (Vercel Marketplace sets these): share links + exact rate limits.
# Locally: run `npx vercel env pull .env.local` to fetch them.
KV_REST_API_URL=
KV_REST_API_TOKEN=
