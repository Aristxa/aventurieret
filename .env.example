# Anthropic API key (https://console.anthropic.com) - used server-side only
ANTHROPIC_API_KEY=

# Mapbox public token (https://account.mapbox.com) - map + place verification
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional: planning depth for each day. low (default, ~1 min per trip) | medium | high  (higher = more careful but slower)
WANDER_EFFORT=low

# Optional: affiliate IDs, added to booking links once you're approved
NEXT_PUBLIC_GYG_PARTNER_ID=
NEXT_PUBLIC_BOOKING_AID=
